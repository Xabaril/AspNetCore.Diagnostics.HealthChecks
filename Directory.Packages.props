    <PackageVersion Include="AWSSDK.SecretsManager" Version="4.1.1.2" />
    <PackageVersion Include="AWSSDK.SimpleNotificationService" Version="4.1.0.2" />
    <PackageVersion Include="AWSSDK.SimpleSystemsManagement" Version="4.1.1.2" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.1.0.2" />
    <PackageVersion Include="Azure.Data.Tables" Version="12.13.0" />
    <PackageVersion Include="Azure.DigitalTwins.Core" Version="1.6.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Messaging.EventHubs" Version="5.12.2" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageVersion Include="Azure.Search.Documents" Version="12.0.0" />
